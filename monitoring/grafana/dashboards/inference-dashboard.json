{
  "uid": "cats-vs-dogs",
  "title": "Cats vs Dogs - Inference Service",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Predictions served",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(predictions_total)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Request rate (req/s)",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(rate(http_requests_total[5m]))", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "p95 latency (s)",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Predictions by label",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"expr": "sum by (label) (rate(predictions_total[5m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Prediction latency percentiles",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean prediction confidence",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "targets": [
        {"expr": "rate(prediction_confidence_sum[5m]) / rate(prediction_confidence_count[5m])", "refId": "A"}
      ]
    }
  ]
}
